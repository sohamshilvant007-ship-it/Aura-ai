{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-ai",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build",
    "watch_paths": ["src/**/*.js"]
  }
}
